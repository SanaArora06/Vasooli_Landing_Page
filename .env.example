# Optional path to the SQLite file used by the pilot signup endpoint.
# Defaults to ./data/pilot.sqlite on the server. Use a persistent disk in production.
# PILOT_DB_PATH=/var/lib/vasooli/pilot.sqlite

# Set to "off" when storage is not available. The form will say signup is unavailable
# and will not show a success message.
# PILOT_STORAGE=off

# Optional comma-separated list of allowed browser Origins for POST /api/pilot.
# When unset, the request Origin host must match the Host header.
# PILOT_ALLOWED_ORIGINS=https://example.com
